#!/usr/bin/env python3
"""Fake yarn logs. Records argv and the environment it was given."""

import os
import sys
from pathlib import Path

log = Path(os.environ["YARN_FAKE_LOG"])
environ_dump = "\n".join(f"{key}={value}" for key, value in sorted(os.environ.items()))
log.write_text(" ".join(sys.argv) + "\n" + environ_dump + "\n")

mode = os.environ.get("YARN_FAKE_MODE", "ok")
if mode == "fail":
    print(os.environ.get("YARN_FAKE_STDERR", "application not found"), file=sys.stderr)
    sys.exit(1)
if mode == "big":
    sys.stdout.buffer.write(b"x" * 200_000)
    sys.exit(0)

text = os.environ.get("YARN_FAKE_TEXT")
if text:
    print(text)
else:
    for i in range(300):
        suffix = " Exception in task" if i == 250 else ""
        print(f"line-{i}{suffix}")
